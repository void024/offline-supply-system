<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Structured JSON request/application logs, per the Prompt 2 infrastructure decision. -->
  <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
    </encoder>
  </appender>

  <logger name="com.offlinesupply.server" level="INFO"/>
  <logger name="com.offlinesupply.server.sync" level="INFO"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE_JSON"/>
  </root>
</configuration>
